# for module compiling
import os
import sys
import subprocess
Import('RTT_ROOT')
Import('env')
from building import *

cwd = GetCurrentDir()
objs = []
dirlist = os.listdir(cwd)

# Package include paths so kernel/board can find stm32f7xx.h, core_cm7.h
env.Append(CPPPATH = [
    os.path.join(cwd, 'packages', 'CMSIS-Core-latest', 'Include'),
    os.path.join(cwd, 'packages', 'stm32f7_cmsis_driver-latest', 'Include'),
    os.path.join(cwd, 'packages', 'stm32f7_hal_driver-latest', 'Inc'),
])
env.Append(CPPDEFINES = ['STM32F767xx', 'USE_HAL_DRIVER'])

# Add hwdef.h location to include path so BSP code (rt_board_init.c) can find it
_ap_root = os.environ.get('AP_ROOT', os.path.abspath(os.path.join(cwd, '..', '..', '..', '..', '..')))
_hwdef_dir = os.path.join(_ap_root, 'build', 'rtt_cuav_v5')
if os.path.isdir(_hwdef_dir):
    env.Append(CPPPATH = [_hwdef_dir])

# Full ArduPilot build: ARDUPILOT_FULL=1 => skip applications, add ArduPilot sources and link once
ARDUPILOT_FULL = os.environ.get('ARDUPILOT_FULL', '0') == '1'

if ARDUPILOT_FULL:
    AP_ROOT = os.environ.get('AP_ROOT', '')
    if not AP_ROOT or not os.path.isfile(os.path.join(AP_ROOT, 'Tools', 'scripts', 'scons_ardupilot_sources.py')):
        AP_ROOT = os.path.abspath(os.path.join(cwd, '..', '..', '..', '..', '..'))
    env.Append(LINKFLAGS=' -Wl,--start-group -lstdc++ -lsupc++ -lgcc -Wl,--end-group')
    env.Append(LIBS=['stdc++', 'supc++', 'gcc'])
    env.Append(LINKFLAGS=' -Wl,--allow-multiple-definition')
    config_py = os.path.join(cwd, 'scons_ardupilot_config.py')
    if not os.path.isfile(config_py):
        script = os.path.join(AP_ROOT, 'Tools', 'scripts', 'scons_ardupilot_sources.py')
        if os.path.isfile(script):
            subprocess.check_call([sys.executable, script, AP_ROOT, '--board', 'rtt_cuav_v5', '--bsp-dir', cwd, '--output', cwd])
    if os.path.isfile(config_py):
        with open(config_py) as f:
            exec(f.read())
        env.Append(CPPPATH=ap_cpppath)
        # Inject #include "hwdef.h" into ap_config.h if not already present.
        # SEEK_* and MCU defines are generated by rtt_hwdef.py into hwdef.h.
        ap_config_h = os.path.join(AP_ROOT, 'build', 'rtt_cuav_v5', 'ap_config.h')
        if os.path.isfile(ap_config_h):
            with open(ap_config_h) as _f:
                _cfg = _f.read()
            if 'hwdef.h' not in _cfg:
                _cfg = _cfg.replace('#define _AP_CONFIG_H_',
                    '#define _AP_CONFIG_H_\n\n#include "hwdef.h"\n', 1)
                with open(ap_config_h, 'w') as _f:
                    _f.write(_cfg)
        ap_force_include = ap_config_h if os.path.isfile(ap_config_h) else ''
        ap_obj_root = os.path.join(AP_ROOT, 'build', 'rtt_cuav_v5', 'ap_objects')
        ap_objs = SConscript(os.path.join(AP_ROOT, 'SConscript_ardupilot'), exports=['env', 'ap_sources', 'ap_cpppath', 'ap_defines', 'ap_force_include', 'ap_obj_root'], duplicate=0)
        objs.extend(list(ap_objs))

for d in dirlist:
    if ARDUPILOT_FULL and d == 'applications':
        continue
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        objs = objs + SConscript(os.path.join(path, 'SConscript'))

def _flatten_objs(lst):
    out = []
    for item in lst:
        if type(item) == type([]):
            out.extend(_flatten_objs(item))
        elif hasattr(item, '__iter__') and not hasattr(item, 'abspath'):
            out.extend(_flatten_objs(list(item)))
        else:
            out.append(item)
    return out
objs = _flatten_objs(objs)

Return('objs')
